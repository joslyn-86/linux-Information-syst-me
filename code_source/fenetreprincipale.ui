  <property name="windowTitle">
   <string>Informations Système</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ── Fenêtre principale ─────────────────────── */
QMainWindow, #widgetCentral {
    background-color: #0d1117;
}

/* ── En-tête ────────────────────────────────── */
#labelTitre {
    font-family: 'Courier New', monospace;
    font-size: 24px;
    font-weight: 700;
    color: #58a6ff;
    letter-spacing: 1px;
}
#labelSousTitre {
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: #6e7681;
    letter-spacing: 2px;
}

/* ── Bouton actualiser ──────────────────────── */
#boutonActualiser {
    background: transparent;
    border: 1px solid #30363d;
    border-radius: 8px;
    color: #8b949e;
    font-family: 'Courier New', monospace;
    font-size: 13px;
    padding: 6px 18px;
    min-width: 120px;
}
#boutonActualiser:hover {
    background: #161b22;
    border-color: #58a6ff;
    color: #58a6ff;
}
#boutonActualiser:pressed {
    background: #0d419d;
    color: #ffffff;
}

/* ── Séparateur ─────────────────────────────── */
#ligneHorizontale {
    color: #21262d;
}

/* ── Cartes ─────────────────────────────────── */
#carteSysteme, #carteCpu, #carteRam, #carteDique, #carteReseau {
    background: #161b22;
    border: 1px solid #21262d;
    border-radius: 12px;
}
#carteSysteme:hover, #carteCpu:hover, #carteRam:hover,
#carteDique:hover, #carteReseau:hover {
    border-color: #30363d;
    background: #1a2030;
}

/* ── Labels titres de section ───────────────── */
#labelTitreSysteme, #labelTitreCpu, #labelTitreRam,
#labelTitreDique, #labelTitreReseau {
    font-family: 'Courier New', monospace;
    font-size: 10px;
    font-weight: 700;
    color: #58a6ff;
    letter-spacing: 2px;
    padding: 0px;
}

/* ── Labels clés (NOM MACHINE, OS…) ─────────── */
#labelNomMachine, #labelSysteme, #labelTempsActivite,
#labelCpuNoyaux, #labelArchitecture, #labelProcessus,
#labelRamTotal, #labelRamDisponible,
#labelDiqueTaille, #labelDiqueUtilise, #labelDiqueLibre,
#labelPaquets, #labelAdresseIP {
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: #6e7681;
    letter-spacing: 1px;
}

/* ── Labels valeurs ─────────────────────────── */
#valeurNomMachine, #valeurSysteme, #valeurTempsActivite,
#valeurCpuNoyaux, #valeurArchitecture, #valeurProcessus,
#valeurRamTotal, #valeurRamDisponible,
#valeurDiqueTaille, #valeurDiqueUtilise, #valeurDiqueLibre,
#valeurPaquets, #valeurAdresseIP {
    font-family: 'Courier New', monospace;
    font-size: 14px;
    font-weight: 600;
    color: #e6edf3;
}

/* ── Barres de progression ──────────────────── */
QProgressBar {
    background: #21262d;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
}
QProgressBar::chunk {
    background: #56d364;
    border-radius: 3px;
}

/* ── Pied de page ───────────────────────────── */
#labelDerniereMaj, #labelAutoRefresh {
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: #484f58;
}

/* ── Icônes ─────────────────────────────────── */
#iconeSysteme, #iconeCpu, #iconeRam, #iconeDique, #iconeReseau {
    font-size: 22px;
    color: #58a6ff;
}
   </string>
